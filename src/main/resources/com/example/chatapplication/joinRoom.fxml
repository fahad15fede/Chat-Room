      <Button fx:id="clearFiltersBtn" layoutX="769.0" layoutY="140.0" mnemonicParsing="false" onAction="#clearFilter" prefHeight="46.0" prefWidth="139.0" stylesheets="@joinRoom.css" text="Clear Filters" />
