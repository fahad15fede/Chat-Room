<AnchorPane fx:id="rootPane" prefHeight="700.0" prefWidth="935.0" stylesheets="@joinRoom.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chatapplication.joinRoomController">
