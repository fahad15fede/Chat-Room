      <ComboBox fx:id="age_groupComboFilter" layoutX="246.0" layoutY="208.0" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="38.0" prefWidth="150.0" promptText="Age-Group" styleClass="menu-button">
