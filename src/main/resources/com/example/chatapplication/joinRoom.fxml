      <Label alignment="CENTER" layoutX="185.0" layoutY="40.0" prefHeight="68.0" prefWidth="523.0" styleClass="titlePage-rest" text="Become a member" />
      <TextField fx:id="searchBar" alignment="CENTER" layoutX="137.0" layoutY="116.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="46.0" prefWidth="542.0" promptText="Search room name or keywords(gaming, study, etc)" />
      <Button fx:id="backBtn" layoutX="34.0" layoutY="40.0" mnemonicParsing="false" onAction="#backtoHome" prefHeight="35.0" prefWidth="70.0" stylesheets="@joinRoom.css" text="⬅" />
      <ComboBox fx:id="locationComboFilter" layoutX="28.0" layoutY="208.0" prefWidth="150.0" promptText="Region" styleClass="menu-button">
