         </cursor>
         <padding>
            <Insets left="40.0" />
         </padding></ComboBox>
      <ComboBox fx:id="TypeComboFilter" layoutX="494.0" layoutY="208.0" prefWidth="150.0" promptText="Type" styleClass="menu-button">
